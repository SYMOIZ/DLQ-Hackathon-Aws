# Copy to .env and fill in. Never commit .env.

# AWS identity (local profile; leave empty on EC2 instance role)
AWS_PROFILE=your-aws-profile

# Core
DLQJ_REGION=us-east-1                          # AWS region for SQS/S3/Bedrock
DLQJ_BEDROCK_MODEL_ID=amazon.nova-micro-v1:0   # Bedrock model for uncertain-band fallback

# Stack / queues
DLQJ_STACK_NAME=dlq-judge                      # CloudFormation stack name
DLQJ_QUEUE_PREFIX=dlqj-                        # Only queues with this prefix are eligible
DLQJ_SOURCE_QUEUE=dlqj-orders                  # Source queue name
DLQJ_DLQ=dlqj-orders-dlq                       # Dead-letter queue name
DLQJ_BUCKET=                                   # Quarantine S3 bucket (from stack output)

# Decider + policy
DLQJ_DECIDER_URL=http://127.0.0.1:8000         # Strands Decider 2B HTTP endpoint
DLQJ_DECIDER_MODEL=StrandsAgents/strands-decider-2B-hobson-v21
DLQJ_DECIDER_TIMEOUT_S=120                     # Decider HTTP timeout
DLQJ_AUTO_MIN=0.85                             # Auto-act if top probability >= this
DLQJ_REVIEW_MIN=0.60                           # Bedrock band lower bound
DLQJ_DISCARD_MIN=0.90                          # Extra bar for discard_duplicate
DLQJ_BEDROCK_MAX_CALLS=50                      # Cap Bedrock calls per triage run
DLQJ_MAX_CLUSTERS=5                            # Cluster rollup limit in UI
DLQJ_BATCH_SIZE=300                            # Max messages per triage
DLQJ_REDRIVE_DELAY_S=300                       # Delay for redrive_later (60–900)

# Runtime
DLQJ_RUNS_DIR=./runs                           # Local audit / run artifacts
DLQJ_UI_PORT=8765                              # UI listen port

# Cognito (from stack outputs; leave empty for local-only)
DLQJ_COGNITO_USER_POOL_ID=                     # e.g. us-east-1_XXXXXXXXX
DLQJ_COGNITO_CLIENT_ID=                        # public app client id (no secret)
